# Sources with LF everywhere.
* text=auto eol=lf

# Test pages and the expected .NET output are compared exactly (positions, CR LF and lone CR pages):
# git must never convert their line endings.
testdata/** -text linguist-vendored

# Not in the source archive GitHub builds from a tag (the gem itself lists its files in fasthtmlparser.gemspec).
/.github export-ignore
/bench export-ignore
/testdata export-ignore
/test export-ignore
/tools export-ignore
/.gitattributes export-ignore
/.gitignore export-ignore
/bench-results.md export-ignore
